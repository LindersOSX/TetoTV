PORT=8787
PUBLIC_BASE_URL=https://your-service.onrender.com

ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Fine-grained GitHub token, stored on the broker only. Restrict it to the
# TetoTV repository with Contents: Read-only.
GITHUB_RELEASE_TOKEN=
GITHUB_RELEASE_REPOSITORY=LindersOSX/TetoTV

# Comma-separated lowercase SHA-256 hashes of opaque tester access keys.
# Store only hashes on the broker; give each tester the corresponding raw key
# through a separate private channel. Rotate/revoke by replacing this list.
BETA_ACCESS_KEY_SHA256_HASHES=

# Anonymous crash reports are accepted only when both values are configured.
# Use the same long random secret on the Discord bot host. Never put it in APKs.
CRASH_REPORT_BOT_URL=https://your-bot-host.example/crash-reports
CRASH_REPORT_SHARED_SECRET=
